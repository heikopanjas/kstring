@PACKAGE_INIT@

# KString CMake Package Configuration File
#
# Usage:
#   find_package(KString REQUIRED)
#   target_link_libraries(myapp PRIVATE KString::kstring)

include("${CMAKE_CURRENT_LIST_DIR}/KStringTargets.cmake")

set(KString_LIBRARIES KString::kstring)
set(KString_INCLUDE_DIRS "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_INCLUDEDIR@")
set(KString_VERSION @PROJECT_VERSION@)

check_required_components(KString)
